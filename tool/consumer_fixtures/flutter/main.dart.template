import 'package:flutter/foundation.dart';
import 'package:flutter/widgets.dart';
import 'package:genetic_engine/genetic_engine.dart';

double solve(int seed) => _solve(seed, useSus: false);
double solveSus(int seed) => _solve(seed, useSus: true);

double _solve(int seed, {required bool useSus}) => GeneticAlgorithm<List<bool>>(
  factory: CallbackGenomeFactory((r) =>
      List.unmodifiable(List.generate(32, (_) => r.nextBool()))),
  evaluator: CallbackFitnessEvaluator((g) => g.where((b) => b).length.toDouble()),
  selection: useSus ? null : TournamentSelection(),
  batchSelection: useSus ? StochasticUniversalSamplingSelection(
      weight: (c) => c.fitness + 1) : null,
  crossover: SinglePointCrossover(),
  mutation: const BitFlipMutation(), mutationRate: 0.3,
  targetFitness: 32, maxGenerations: 200, seed: seed,
).run().best.fitness;

void main() => runApp(const ConsumerApp());

class ConsumerApp extends StatelessWidget {
  const ConsumerApp({super.key, this.result});
  final Future<double>? result;
  @override
  Widget build(BuildContext context) => WidgetsApp(
    color: const Color(0xFF212121),
    builder: (context, child) => FutureBuilder<double>(
      future: result ?? compute(solveSus, 42),
      builder: (context, snapshot) => Center(child: Text(
        snapshot.hasData ? 'Fitness: ${snapshot.data!.toInt()}' : 'Optimizing',
      )),
    ),
  );
}
